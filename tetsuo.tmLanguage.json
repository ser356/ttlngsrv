{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tetsuo",
  "scopeName": "source.tetsuo",
  "fileTypes": [
    "tt"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#nil"
    },
    {
      "include": "#function-def"
    },
    {
      "include": "#struct-def"
    },
    {
      "include": "#bss-def"
    },
    {
      "include": "#const-def"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#declared-name"
    },
    {
      "include": "#type-annotation-primitive"
    },
    {
      "include": "#type-annotation"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tetsuo",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.tetsuo"
            }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.single.tetsuo",
      "begin": "'",
      "end": "'|(?=$)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tetsuo"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tetsuo"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tetsuo",
          "match": "\\\\(?:x[0-9A-Fa-f]{2}|[nt0'\\\\])"
        },
        {
          "name": "invalid.illegal.unknown-escape.tetsuo",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tetsuo",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "invalid.illegal.numeric.tetsuo",
          "match": "\\b0[xX](?![0-9a-fA-F])"
        },
        {
          "name": "constant.numeric.decimal.tetsuo",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tetsuo",
          "match": "\\b(return|if|else|loop|while|break)\\b"
        },
        {
          "name": "keyword.control.import.tetsuo",
          "match": "^\\s*\\bimport\\b"
        },
        {
          "name": "storage.type.function.tetsuo",
          "match": "\\bfun\\b"
        },
        {
          "name": "storage.type.tetsuo",
          "match": "\\b(let|struct)\\b"
        },
        {
          "name": "storage.modifier.tetsuo",
          "match": "\\b(const|bss)\\b"
        }
      ]
    },
    "types": {
      "name": "support.type.primitive.tetsuo",
      "match": "\\b(u8|u32|u64|str)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.tetsuo",
      "match": "\\b(sizeof|syscall)\\b(?=\\s*\\()"
    },
    "nil": {
      "name": "constant.language.nil.tetsuo",
      "match": "\\b(nil)\\b"
    },
    "function-def": {
      "match": "(?<=\\bfun)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "entity.name.function.tetsuo"
        }
      }
    },
    "struct-def": {
      "match": "(?<=\\bstruct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "entity.name.type.struct.tetsuo"
        }
      }
    },
    "bss-def": {
      "match": "(?<=\\bbss)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "variable.other.constant.tetsuo"
        }
      }
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.tetsuo"
        }
      }
    },
    "properties": {
      "patterns": [
        {
          "match": "(\\.)(ptr|len)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.tetsuo"
            },
            "2": {
              "name": "support.variable.property.builtin.tetsuo"
            }
          }
        },
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.tetsuo"
            },
            "2": {
              "name": "variable.other.member.tetsuo"
            }
          }
        }
      ]
    },
    "declared-name": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=:)",
      "captures": {
        "1": {
          "name": "variable.other.declaration.tetsuo"
        }
      }
    },
    "type-annotation": {
      "match": "(:|->)\\s*(\\*\\s*)*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.operator.type.tetsuo"
        },
        "2": {
          "name": "keyword.operator.pointer.tetsuo"
        },
        "3": {
          "name": "entity.name.type.tetsuo"
        }
      }
    },
    "constants": {
      "name": "variable.other.constant.tetsuo",
      "match": "\\b[A-Z][A-Z0-9_]*\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.volatile.tetsuo",
          "match": "@"
        },
        {
          "name": "keyword.operator.arrow.tetsuo",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.tetsuo",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.tetsuo",
          "match": "="
        },
        {
          "name": "keyword.operator.address.tetsuo",
          "match": "&(?=[A-Za-z_])"
        },
        {
          "name": "keyword.operator.bitwise.tetsuo",
          "match": "&|\\||\\^"
        },
        {
          "name": "keyword.operator.arithmetic.tetsuo",
          "match": "\\+|-|\\*|/"
        },
        {
          "name": "punctuation.separator.tetsuo",
          "match": "[,;:]"
        }
      ]
    },
    "type-annotation-primitive": {
      "match": "(:|->)\\s*(\\*\\s*)*\\b(u8|u32|u64|str)\\b",
      "captures": {
        "1": {
          "name": "keyword.operator.type.tetsuo"
        },
        "2": {
          "name": "keyword.operator.pointer.tetsuo"
        },
        "3": {
          "name": "support.type.primitive.tetsuo"
        }
      }
    },
    "const-def": {
      "match": "(?<=\\bconst)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "variable.other.constant.tetsuo"
        }
      }
    }
  }
}
