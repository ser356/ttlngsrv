{
  "name": "tetsuo",
  "displayName": "tetsuo",
  "description": "Lenguaje tetsuo — highlighting, snippets, diagnósticos y hover vía LSP",
  "version": "0.4.0",
  "publisher": "ser356",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:tetsuo"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tetsuo",
        "aliases": [
          "tetsuo",
          "tt"
        ],
        "extensions": [
          ".tt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tetsuo",
        "scopeName": "source.tetsuo",
        "path": "./tetsuo.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tetsuo",
        "path": "./tetsuo.json"
      }
    ],
    "configuration": {
      "title": "tetsuo",
      "properties": {
        "tetsuo.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Ruta absoluta al binario del compilador tetsuo. Se invoca con `--dump-ir` para diagnósticos. Vacío = se busca `build/main` en la raíz del proyecto."
        },
        "tetsuo.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Raíz contra la que se resuelven las rutas de `import`. Vacío = el ancestro más cercano con `.git`."
        },
        "tetsuo.prelude": {
          "type": "boolean",
          "default": true,
          "description": "Para un .tt suelto y sin `import` propios (por ejemplo un test), compilarlo detrás de las unidades de librería del proyecto en lugar de aislado."
        },
        "tetsuo.entryFile": {
          "type": "string",
          "default": "",
          "description": "Fichero raíz que se compila para diagnosticar (relativo a la raíz del proyecto). Vacío = se deduce del grafo de imports; por ejemplo `tests/fixpoint_entry.tt` en el repo tetsuo."
        },
        "tetsuo.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "sync-spec": "node scripts/sync-spec.mjs ../tetsuo",
    "sync-spec:apply": "./sync.sh",
    "tree-sitter:generate": "npm --prefix tree-sitter-tetsuo run generate",
    "tree-sitter:test": "npm --prefix tree-sitter-tetsuo test",
    "package": "npm run compile && vsce package --allow-missing-repository -o tetsuo.vsix",
    "install-vsix": "code --install-extension tetsuo.vsix --force",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.5"
  }
}
